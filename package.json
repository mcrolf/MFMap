{
  "name": "mfmap",
  "version": "0.1.0",
  "description": "Builds and maintains an agent-readable map of a codebase: files, symbols, imports, and dependencies.",
  "type": "module",
  "bin": {
    "mfmap": "skill/codebase-map/bin/mfmap.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings 'test/**/*.test.ts'",
    "install-skill": "npm run build && node scripts/install-skill.mjs"
  },
  "dependencies": {
    "ignore": "7.0.5",
    "smol-toml": "1.3.4",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "esbuild": "0.25.0",
    "typescript": "5.8.3"
  }
}
